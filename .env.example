PORT=3000
API_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://your-website.example

IMAP_HOST=mail.privateemail.com
IMAP_PORT=993
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465

# Automatic acknowledgements: four mailboxes use the shared reply; support uses
# the shared opening plus a dedicated support follow-up. Keep the interval at
# 30 seconds or more to avoid excessive IMAP connections.
AUTOREPLY_ENABLED=true
AUTOREPLY_INTERVAL_MS=60000
AUTOREPLY_SPECIAL_ACCOUNT=support
AUTOREPLY_GENERIC_TEXT=شكراً لتواصلكم مع المثاني. تم استلام رسالتكم بنجاح، وسيقوم الفريق المختص بمراجعتها والرد عليكم في أقرب وقت ممكن.\n\nThank you for contacting Almathanie. Your message has been received and our team will respond as soon as possible.
AUTOREPLY_SPECIAL_TEXT=شكراً لتواصلكم مع المثاني. تم استلام رسالتكم بنجاح، وسيقوم الفريق المختص بمراجعتها والرد عليكم في أقرب وقت ممكن.\n\nThank you for contacting Almathanie. Your message has been received and our team will respond as soon as possible.\n\nتم تحويل رسالتكم تلقائياً إلى فريق الدعم والمتابعة. يرجى الاحتفاظ بعنوان هذه الرسالة لتسهيل متابعة طلبكم.

# Keep real passwords only in your hosting provider's secret settings.
# Every mailbox stays separate and has its own password variable.
MAILBOX_IDS=compliance,info,noreply,support,transfers
MAILBOX_COMPLIANCE_EMAIL=compliance@almathanie.com
MAILBOX_COMPLIANCE_PASSWORD=replace-in-hosting-secrets
MAILBOX_INFO_EMAIL=info@almathanie.com
MAILBOX_INFO_PASSWORD=replace-in-hosting-secrets
MAILBOX_NOREPLY_EMAIL=noreply@almathanie.com
MAILBOX_NOREPLY_PASSWORD=replace-in-hosting-secrets
MAILBOX_SUPPORT_EMAIL=support@almathanie.com
MAILBOX_SUPPORT_PASSWORD=replace-in-hosting-secrets
MAILBOX_TRANSFERS_EMAIL=transfers@almathanie.com
MAILBOX_TRANSFERS_PASSWORD=replace-in-hosting-secrets
