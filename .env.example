PORT=3000
API_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://your-website.example

IMAP_HOST=mail.privateemail.com
IMAP_PORT=993
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465

# Keep real passwords only in your hosting provider's secret settings.
# Add one object per mailbox so every mailbox stays separate.
MAIL_ACCOUNTS_JSON=[{"id":"info","label":"Info","email":"info@example.com","password":"replace-in-hosting-secrets"},{"id":"support","label":"Support","email":"support@example.com","password":"replace-in-hosting-secrets"}]
